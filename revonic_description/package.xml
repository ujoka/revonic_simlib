<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>revonic_description</name>
  <version>0.1.0</version>
  <description>
    This package contains a C++ parser for the Unified Robot Description
    Format (URDF), which is an XML format for representing a robot model.
    This package contains configuration data, 3D models and launch files
    for revonic_eva2 robot.
  </description>
  <author email="asebastian.martinez1@gmail.com">Andres S. Martinez</author>
  <maintainer email="asebastian.martinez1@gmail.com">Andres S. Martinez</maintainer>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/ros2/urdf</url>
  <url type="bugtracker">https://github.com/ros2/urdf/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>